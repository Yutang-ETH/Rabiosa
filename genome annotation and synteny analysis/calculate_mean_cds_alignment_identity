# Starting with the pairwise cds alignment file generated by MCscan pipeline (with the aligner last), we did the following to calculate the mean cds alignment identity :
# First, get the anchors with the following command:
paste -d "_" <(awk '$1~/Lm2/ && $2~/Lm1/ {print $1}' assembly1.assembly2.anchors) <(awk '$1~/Lm2/ && $2~/Lm1/ {print $2}' assembly1.assembly2.anchors) > Rabiosa_h1_h2_anchor.pair

# This is how the input file assembly1.assembly2.anchors in the above command looks like:
# Lm2.chr1.7      Lm1.chr1.93     1580
# Lm2.chr1.10     Lm1.chr1.92     433
# Lm2.chr1.33     Lm1.chr1.78     2700

# After running the command, the output file, Rabiosa_h1_h2_anchor.pair, looks like the following:
# Lm2.chr1.7_Lm1.chr1.93
# Lm2.chr1.10_Lm1.chr1.92
# Lm2.chr1.33_Lm1.chr1.78

# Now, these anchors are searched for in the last alignment file, and the mean alignment identity is calculated with this one-liner command:
awk '$1~/Lm2/ && $2~/Lm1/ {print $0}' assembly1.assembly2.last.filtered | tr "\t" "_" | grep -f Rabiosa_h1_h2_anchor.pair | awk -F "_" '{sum+=$3; n++} END {print n, sum/n}'
# This command printed out the following results:
# 13308 (number of anchors), 98.2197 (the mean alignment identity)
